# Runtime database URL. A pooled URL is fine for the API/worker.
DATABASE_URL=postgresql://product_tracker:product_tracker@localhost:5434/product_tracker?schema=public
# Optional direct endpoint used by Prisma migrations in hosted environments.
DIRECT_URL=postgresql://product_tracker:product_tracker@localhost:5434/product_tracker?schema=public

PORT=8080
API_BEARER_TOKEN=replace-with-a-random-secret-at-least-24-characters

# Notion internal integration token. Never commit a real token.
NOTION_TOKEN=
# Canonical Notion data source IDs (UUIDs; collection:// prefix is also accepted).
NOTION_SHOPPING_NEEDS_DATA_SOURCE_ID=
NOTION_PRODUCTS_DATA_SOURCE_ID=
NOTION_INVENTORY_EVENTS_DATA_SOURCE_ID=
# One-time token Notion sends when the webhook subscription is created.
# After copying it from the first webhook log, store it here in the deployment secret store.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=20
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
