{
  "name": "product-tracker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "bootstrap:notion": "tsx scripts/bootstrap-notion.ts",
    "db:migrate:dev": "prisma migrate dev --name init",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 20260831114000_init",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:dry": "wrangler deploy --dry-run",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:tail": "wrangler tail",
    "cloudflare:queue:create": "wrangler queues create llm4life-product-tracker-events",
    "cloudflare:dlq:create": "wrangler queues create llm4life-product-tracker-events-dlq",
    "cloudflare:reliability:dry": "wrangler deploy --dry-run --config wrangler.reliability.jsonc && wrangler deploy --dry-run --config wrangler.reliability-dlq.jsonc",
    "cloudflare:reliability:deploy": "wrangler deploy --config wrangler.reliability.jsonc",
    "cloudflare:reliability:dlq:deploy": "wrangler deploy --config wrangler.reliability-dlq.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "^5.6.2",
    "fastify-raw-body": "^6.0.1",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "3.24.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
