generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryEventType {
  BASELINE
  PURCHASED
  OPENED
  FINISHED
  RETURNED
  DISCARDED
  ADJUSTMENT
}

enum InventoryEventSource {
  API
  NOTION
  IMPORT
  SYSTEM
}

enum OutboxType {
  NOTION_PRODUCT_STATE
  NOTION_INVENTORY_EVENT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ProductType {
  PERSONAL_CARE
  SUPPLEMENT
  OTHER
}

enum SupplementPriority {
  CORE
  OPTIONAL
  SITUATIONAL
}

model InventoryNeed {
  id                 String            @id @default(cuid())
  key                String            @unique
  name               String
  aisle              String?
  active             Boolean           @default(true)
  backupTarget       Int               @default(1)
  reorderPoint       Int               @default(1)
  defaultRetailer    String?
  notes              String?
  notionPageId       String?           @unique
  notionLastEditedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  products           Product[]
  events             InventoryEvent[]
  supplementPlan     SupplementPlan?

  @@index([active])
}

model Product {
  id                  String             @id @default(cuid())
  key                 String             @unique
  needId              String
  name                String
  brand               String?
  productType         ProductType        @default(PERSONAL_CARE)
  careArea            String?
  active              Boolean            @default(true)
  paoMonths           Int?
  price               Decimal?           @db.Decimal(12, 2)
  productUrl          String?
  repurchasePolicy    String?
  retailerOverride    String?
  notes               String?
  needsIdentification Boolean            @default(false)
  notionPageId        String?            @unique
  notionLastEditedAt  DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  need                InventoryNeed      @relation(fields: [needId], references: [id], onDelete: Restrict)
  balance             InventoryBalance?
  events              InventoryEvent[]
  supplementProfile   SupplementProfile?

  @@index([needId, active])
  @@index([productType, active])
}

model InventoryBalance {
  productId   String   @id
  backupUnits Int      @default(0)
  inUseUnits  Int      @default(0)
  openedAt    DateTime?
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryEvent {
  id                String               @id @default(cuid())
  productId         String
  needId            String
  type              InventoryEventType
  source            InventoryEventSource
  backupDelta       Int                  @default(0)
  inUseDelta        Int                  @default(0)
  quantityDelta     Int                  @default(0)
  occurredAt        DateTime
  recordedAt        DateTime             @default(now())
  idempotencyKey    String               @unique
  requestHash       String?
  externalEventId   String?
  note              String?
  notionEventPageId String?              @unique
  product           Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  need              InventoryNeed        @relation(fields: [needId], references: [id], onDelete: Restrict)

  @@index([productId, occurredAt])
  @@index([needId, occurredAt])
}

model SupplementPlan {
  needId          String             @id
  priority        SupplementPriority
  targetMinAmount Decimal?           @db.Decimal(12, 4)
  targetMaxAmount Decimal?           @db.Decimal(12, 4)
  targetUnit      String?
  frequency       String?
  instructions    String?
  rationale       String?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  need            InventoryNeed      @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@index([priority, active])
}

model SupplementProfile {
  productId            String                 @id
  form                 String?
  servingSize          Decimal?               @db.Decimal(12, 4)
  servingUnit          String?
  servingsPerContainer Decimal?               @db.Decimal(12, 2)
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients          SupplementIngredient[]
}

model SupplementIngredient {
  id               String            @id @default(cuid())
  productId        String
  key              String
  name             String
  amountPerServing Decimal?          @db.Decimal(12, 4)
  unit             String?
  form             String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          SupplementProfile @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([productId, key])
  @@index([key])
}

model OutboxEvent {
  id          String       @id @default(cuid())
  type        OutboxType
  status      OutboxStatus @default(PENDING)
  aggregateId String
  dedupeKey   String       @unique
  payload     Json
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
}

model WebhookReceipt {
  id              String   @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  entityId        String?
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  attempts        Int      @default(0)
  availableAt     DateTime @default(now())
  lockedAt        DateTime?
  lastError       String?
  payload         Json

  @@unique([provider, externalEventId])
  @@index([provider, processedAt, availableAt])
}

model DeadLetterEvent {
  id         String   @id @default(cuid())
  messageId  String   @unique
  queueName  String
  attempts   Int
  sentAt     DateTime
  receivedAt DateTime @default(now())
  bodyType   String
  workKind   String?
  workId     String?
  resolvedAt DateTime?
  note       String?

  @@index([resolvedAt, receivedAt])
}
